# Copy to .env and fill in. .env is git-ignored.
GOOGLE_API_KEY=your-gemini-api-key

# Optional overrides (defaults shown)
# RG_LLM_MODEL=gemini-3.8-flash
# RG_LLM_TIMEOUT_S=90
# RG_LLM_MAX_RETRIES=3
# RG_LLM_MIN_INTERVAL_S=0      # set ~7 on a free-tier key to stay under the per-minute limit
# RG_BG_MODEL=u2net
# RG_DATA_DIR=./data
